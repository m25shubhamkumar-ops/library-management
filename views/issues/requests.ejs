<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 text-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full bg-slate-50">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Pending Issue Requests</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
            <%= requests.length %> Pending
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Review member book loan requests, verify available copies and member quotas before approval.</p>
      </div>

      <div class="flex items-center gap-2">
        <a href="/issues/issued" class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 border border-slate-200 shadow-sm transition-colors">
          View All Active Loans &rarr;
        </a>
      </div>
    </div>

    <!-- Requests Table -->
    <div class="mt-8 bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
      <% if (requests.length === 0) { %>
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">✨</div>
          <h3 class="text-base font-semibold text-slate-800">No pending issue requests</h3>
          <p class="text-xs text-slate-500 mt-1">All member lending requests have been processed.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3.5 px-6">Member Details</th>
                <th class="py-3.5 px-6">Requested Book</th>
                <th class="py-3.5 px-6">Catalog Availability</th>
                <th class="py-3.5 px-6">Requested Date</th>
                <th class="py-3.5 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% requests.forEach(req => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  
                  <!-- Member Details -->
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900 text-sm">
                      <%= req.member ? req.member.name : 'Unknown Member' %>
                    </div>
                    <div class="text-slate-500 text-xs mt-0.5">
                      <%= req.member ? req.member.email : 'No email' %>
                    </div>
                    <% if (req.member && req.member.phone) { %>
                      <div class="text-slate-400 text-[11px] mt-0.5 font-mono">
                        📞 <%= req.member.phone %>
                      </div>
                    <% } %>
                  </td>

                  <!-- Book Details -->
                  <td class="py-4 px-6">
                    <% if (req.book) { %>
                      <a href="/books/<%= req.book._id %>" class="font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                        <%= req.book.title %>
                      </a>
                      <div class="text-slate-500 text-[11px]">
                        by <%= req.book.author %> • <span class="font-mono">ISBN: <%= req.book.ISBN %></span>
                      </div>
                    <% } else { %>
                      <span class="text-rose-500 italic">Book no longer in catalog</span>
                    <% } %>
                  </td>

                  <!-- Availability -->
                  <td class="py-4 px-6">
                    <% if (req.book) { %>
                      <% if (req.book.availableCopies > 0) { %>
                        <span class="inline-flex items-center text-xs font-semibold text-emerald-600">
                          <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
                          <%= req.book.availableCopies %> / <%= req.book.totalCopies %> copies available
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center text-xs font-semibold text-rose-600">
                          <span class="w-2 h-2 rounded-full bg-rose-500 mr-2"></span>
                          0 copies available (Backlog)
                        </span>
                      <% } %>
                    <% } %>
                  </td>

                  <!-- Date -->
                  <td class="py-4 px-6 text-slate-600">
                    <%= new Date(req.createdAt).toLocaleDateString() %>
                    <span class="block text-[10px] text-slate-400">
                      <%= new Date(req.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2">
                      
                      <!-- Approve Form -->
                      <form action="/issues/approve/<%= req._id %>" method="POST">
                        <button type="submit"
                          <%= (req.book && req.book.availableCopies <= 0) ? 'disabled' : '' %>
                          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed shadow-sm transition-all">
                          ✓ Approve (Issue)
                        </button>
                      </form>

                      <!-- Reject Form -->
                      <form action="/issues/reject/<%= req._id %>" method="POST"
                        onsubmit="return confirm('Are you sure you want to reject this request?');">
                        <button type="submit"
                          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all">
                          ✕ Decline
                        </button>
                      </form>

                    </div>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
