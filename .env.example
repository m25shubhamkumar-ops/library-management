# Application Port
PORT=3000

# Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string when deploying to Render
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_db?retryWrites=true&w=majority

# Local MongoDB alternative:
# MONGO_URI=mongodb://127.0.0.1:27017/library_db

# Session Secret (Generate a strong random string in production)
SESSION_SECRET=super_secret_library_session_key_2026_dev_prod

# Library Rules & Policies
FINE_PER_DAY=10
MAX_BORROW_LIMIT=3
DEFAULT_DUE_DAYS=7
