<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 text-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full bg-slate-50">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">My Borrowed Books</h1>
        <p class="text-xs text-slate-500 mt-1">Track your borrowed reading materials, due dates, pending requests, and return history.</p>
      </div>
      <div>
        <a href="/books" class="inline-flex items-center px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md shadow-indigo-600/20 transition-all">
          Browse Catalog to Borrow &rarr;
        </a>
      </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs text-slate-500 uppercase font-semibold">Active Loans</div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-black text-slate-900"><%= activeLoans.length %></span>
          <span class="text-xs text-slate-400">Max limit: <%= maxBorrowLimit %> books</span>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs text-slate-500 uppercase font-semibold">Pending Requests</div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-black text-amber-600"><%= pendingRequests.length %></span>
          <span class="text-xs text-slate-400">Awaiting librarian</span>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs text-slate-500 uppercase font-semibold">Total Fines</div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-black <%= totalFines > 0 ? 'text-rose-600' : 'text-emerald-600' %>">
            ₹<%= totalFines %>
          </span>
          <span class="text-xs text-slate-400">₹<%= finePerDay %>/overdue day</span>
        </div>
      </div>
    </div>

    <!-- Section 1: Active Books Borrowed -->
    <div class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>📖</span> Currently In Your Possession (<%= activeLoans.length %>)
        </h2>
      </div>

      <% if (activeLoans.length === 0) { %>
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-sm text-center">
          <p class="text-xs text-slate-500">You do not currently have any active loans.</p>
          <a href="/books" class="mt-3 inline-block px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-800 transition-colors border border-slate-200">
            Find books in the catalog
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% activeLoans.forEach(loan => { %>
            <div class="rounded-2xl p-5 flex flex-col justify-between shadow-sm border <%= loan.isDynamicallyOverdue ? 'border-rose-300 bg-rose-50/50' : 'bg-white border-slate-200' %>">
              <div>
                <div class="flex justify-between items-start">
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                    <%= loan.book ? loan.book.category : 'General' %>
                  </span>
                  
                  <% if (loan.isDynamicallyOverdue) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-rose-100 text-rose-700 border border-rose-200">
                      Overdue (<%= loan.overdueDays %> days)
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-indigo-50 text-indigo-700 border border-indigo-200">
                      Active
                    </span>
                  <% } %>
                </div>

                <h3 class="font-bold text-base text-slate-900 mt-3">
                  <%= loan.book ? loan.book.title : 'Book Title' %>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">by <%= loan.book ? loan.book.author : 'Author' %></p>

                <!-- Dates Box -->
                <div class="mt-4 p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1 text-xs">
                  <div class="flex justify-between text-slate-500">
                    <span>Issued on:</span>
                    <span class="font-mono text-slate-800"><%= loan.issueDate ? new Date(loan.issueDate).toLocaleDateString() : '—' %></span>
                  </div>
                  <div class="flex justify-between text-slate-500">
                    <span>Due on:</span>
                    <span class="font-mono <%= loan.isDynamicallyOverdue ? 'text-rose-600 font-bold' : 'text-slate-800' %>">
                      <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString() : '—' %>
                    </span>
                  </div>
                  <% if (loan.isDynamicallyOverdue) { %>
                    <div class="flex justify-between text-rose-600 font-semibold pt-1 border-t border-rose-200">
                      <span>Accrued Fine:</span>
                      <span class="font-mono">₹<%= loan.currentFine %></span>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Return Action -->
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
                <a href="/books/<%= loan.book ? loan.book._id : '#' %>" class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold">
                  Book Details &rarr;
                </a>

                <form action="/issues/return/<%= loan._id %>" method="POST"
                  onsubmit="return confirm('Confirm book return?');">
                  <button type="submit"
                    class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition-all">
                    Return Book
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Section 2: Pending Requests -->
    <% if (pendingRequests.length > 0) { %>
      <div class="mt-12">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2 mb-4">
          <span>⏳</span> Pending Issue Requests (<%= pendingRequests.length %>)
        </h2>
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-6">Book Title</th>
                <th class="py-3 px-6">Requested Date</th>
                <th class="py-3 px-6">Current Availability</th>
                <th class="py-3 px-6 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% pendingRequests.forEach(req => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-6 font-semibold text-slate-900">
                    <%= req.book ? req.book.title : 'Title' %>
                    <span class="block text-[11px] text-slate-400 font-normal">by <%= req.book ? req.book.author : '' %></span>
                  </td>
                  <td class="py-3.5 px-6 text-slate-600 font-mono">
                    <%= new Date(req.createdAt).toLocaleDateString() %>
                  </td>
                  <td class="py-3.5 px-6">
                    <span class="text-emerald-600 font-semibold">
                      <%= req.book ? req.book.availableCopies : 0 %> copies in stock
                    </span>
                  </td>
                  <td class="py-3.5 px-6 text-right">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-amber-50 text-amber-700 border border-amber-200">
                      Awaiting Approval
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- Section 3: Past History -->
    <% if (history.length > 0) { %>
      <div class="mt-12">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2 mb-4">
          <span>📜</span> Borrowing History (<%= history.length %>)
        </h2>
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-6">Book Title</th>
                <th class="py-3 px-6">Issue Date</th>
                <th class="py-3 px-6">Return Date</th>
                <th class="py-3 px-6">Status</th>
                <th class="py-3 px-6 text-right">Fine Settled</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% history.forEach(item => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-6 font-semibold text-slate-900">
                    <%= item.book ? item.book.title : 'Title' %>
                  </td>
                  <td class="py-3.5 px-6 text-slate-600 font-mono">
                    <%= item.issueDate ? new Date(item.issueDate).toLocaleDateString() : '—' %>
                  </td>
                  <td class="py-3.5 px-6 text-slate-600 font-mono">
                    <%= item.returnDate ? new Date(item.returnDate).toLocaleDateString() : '—' %>
                  </td>
                  <td class="py-3.5 px-6">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= item.status === 'returned' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-600' %>">
                      <%= item.status %>
                    </span>
                  </td>
                  <td class="py-3.5 px-6 text-right font-mono font-semibold <%= item.fine > 0 ? 'text-rose-600' : 'text-slate-400' %>">
                    <%= item.fine > 0 ? '₹' + item.fine : '₹0' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
