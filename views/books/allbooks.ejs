<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 text-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full bg-slate-50">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero / Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Library Catalog</h1>
        <p class="text-sm text-slate-600 mt-1 font-medium">
          Explore our collection of <span class="text-indigo-600 font-bold"><%= totalCatalogCount %></span> titles across literature, sciences, and humanities.
        </p>
      </div>

      <% if (currentUser && currentUser.role === 'librarian') { %>
        <div>
          <a href="/books/add" class="inline-flex items-center px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-md shadow-indigo-200 transition-all">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add New Book
          </a>
        </div>
      <% } %>
    </div>

    <!-- Search & Filter Bar -->
    <form action="/books" method="GET" class="mt-6 bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        
        <!-- Search Input -->
        <div class="md:col-span-6 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input type="text" name="search" value="<%= searchQuery %>"
            placeholder="Search by title, author, or ISBN..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium">
        </div>

        <!-- Category Dropdown -->
        <div class="md:col-span-4">
          <select name="category"
            class="w-full px-3 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium">
            <option value="All" <%= (selectedCategory === 'All') ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= (selectedCategory === cat) ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <!-- Submit & Reset Buttons -->
        <div class="md:col-span-2 flex items-center gap-2">
          <button type="submit"
            class="flex-1 py-2.5 px-4 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all text-center">
            Filter
          </button>
          <% if (searchQuery || selectedCategory !== 'All') { %>
            <a href="/books"
              class="py-2.5 px-3 rounded-xl text-xs font-bold text-slate-500 bg-slate-100 hover:bg-slate-200 hover:text-slate-800 transition-all text-center" title="Reset Filters">
              ✕
            </a>
          <% } %>
        </div>

      </div>
    </form>

    <!-- Books Results Grid -->
    <div class="mt-8">
      <% if (books.length === 0) { %>
        <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <div class="text-4xl mb-3">🔍</div>
          <h3 class="text-lg font-bold text-slate-800">No books found</h3>
          <p class="text-sm text-slate-500 max-w-sm mx-auto mt-1">
            No titles match your query. Try broadening your search or choosing "All Categories".
          </p>
          <a href="/books" class="mt-4 inline-block px-4 py-2 text-xs font-bold text-indigo-700 bg-indigo-50 rounded-xl border border-indigo-200 hover:bg-indigo-100">
            Clear all filters
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% books.forEach(book => { %>
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-indigo-300 hover:shadow-lg hover:shadow-slate-200/50 transition-all duration-200 flex flex-col group">
              
              <!-- Card Header / Category Banner -->
              <div class="h-28 bg-gradient-to-br from-indigo-50 via-sky-50 to-purple-50 p-4 flex flex-col justify-between relative overflow-hidden border-b border-slate-100">
                <div class="flex justify-between items-start z-10">
                  <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-white/90 text-indigo-700 border border-indigo-200 shadow-xs backdrop-blur-sm">
                    <%= book.category %>
                  </span>
                  
                  <% if (book.availableCopies > 0) { %>
                    <span class="inline-flex items-center text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-300 shadow-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                      <%= book.availableCopies %> Available
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-300 shadow-xs">
                      Out of stock
                    </span>
                  <% } %>
                </div>
                
                <div class="text-[11px] text-slate-500 font-mono z-10 font-medium">
                  ISBN: <%= book.ISBN %>
                </div>

                <!-- Subtle Decorative Pattern -->
                <div class="absolute -right-3 -bottom-5 text-6xl opacity-15 font-serif select-none pointer-events-none">
                  📖
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                <div>
                  <h3 class="font-bold text-base text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-1">
                    <a href="/books/<%= book._id %>"><%= book.title %></a>
                  </h3>
                  <p class="text-xs text-slate-500 mt-1 font-semibold">By <%= book.author %></p>
                  
                  <% if (book.description) { %>
                    <p class="text-xs text-slate-600 mt-2.5 line-clamp-2 leading-relaxed">
                      <%= book.description %>
                    </p>
                  <% } %>
                </div>

                <!-- Copy Stats Bar -->
                <div class="pt-3 border-t border-slate-100">
                  <div class="flex justify-between text-xs text-slate-600 mb-1.5 font-medium">
                    <span>Stock: <strong class="text-slate-800"><%= book.availableCopies %> / <%= book.totalCopies %></strong></span>
                    <span>Borrowed: <strong class="text-indigo-600"><%= book.borrowCount %> times</strong></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <% const availPct = book.totalCopies > 0 ? (book.availableCopies / book.totalCopies) * 100 : 0; %>
                    <div class="h-2 rounded-full <%= availPct > 20 ? 'bg-emerald-500' : (availPct > 0 ? 'bg-amber-500' : 'bg-rose-500') %>" style="width: <%= availPct %>%;"></div>
                  </div>
                </div>

                <!-- Action Button -->
                <div class="pt-1">
                  <a href="/books/<%= book._id %>"
                    class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 hover:bg-indigo-600 hover:text-white hover:border-indigo-600 shadow-sm transition-all">
                    View Details & Lending &rarr;
                  </a>
                </div>

              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
