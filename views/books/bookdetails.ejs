<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 text-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full bg-slate-50">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center space-x-2 text-xs font-semibold text-slate-500">
      <a href="/books" class="hover:text-indigo-600 transition-colors">Catalog</a>
      <span>/</span>
      <span class="text-slate-600"><%= book.category %></span>
      <span>/</span>
      <span class="text-indigo-600 font-bold truncate max-w-xs"><%= book.title %></span>
    </nav>

    <!-- Book Hero Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xl shadow-slate-200/50">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Left: Decorative Book Spine & Metrics -->
        <div class="md:col-span-4 flex flex-col items-center">
          <div class="w-full max-w-[240px] aspect-[2/3] rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-800 border border-indigo-400 shadow-2xl shadow-indigo-300/60 p-6 flex flex-col justify-between relative overflow-hidden text-white">
            <div class="z-10">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded bg-white/20 text-white border border-white/30 backdrop-blur-sm">
                <%= book.category %>
              </span>
              <h2 class="text-lg font-black text-white mt-3 leading-snug line-clamp-3">
                <%= book.title %>
              </h2>
              <p class="text-xs text-indigo-100 mt-1 font-medium">by <%= book.author %></p>
            </div>

            <div class="z-10 pt-4 border-t border-white/20 text-[11px] font-mono text-indigo-100">
              <div>ISBN: <%= book.ISBN %></div>
              <div>Year: <%= book.publishedYear || 'N/A' %></div>
            </div>

            <div class="absolute -right-6 -bottom-6 text-9xl opacity-15 font-serif select-none pointer-events-none">
              📚
            </div>
          </div>

          <!-- Quick Stats Pills -->
          <div class="w-full max-w-[240px] mt-4 space-y-2 text-xs">
            <div class="flex justify-between items-center px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-500 font-medium">Total Copies:</span>
              <span class="font-bold text-slate-800"><%= book.totalCopies %></span>
            </div>
            <div class="flex justify-between items-center px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-500 font-medium">Available:</span>
              <span class="font-bold <%= book.availableCopies > 0 ? 'text-emerald-600' : 'text-rose-600' %>">
                <%= book.availableCopies %>
              </span>
            </div>
            <div class="flex justify-between items-center px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-slate-500 font-medium">Times Borrowed:</span>
              <span class="font-bold text-indigo-600"><%= book.borrowCount %></span>
            </div>
          </div>
        </div>

        <!-- Right: Details & Action Controls -->
        <div class="md:col-span-8 flex flex-col justify-between space-y-6">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200">
                <%= book.category %>
              </span>
              <% if (book.availableCopies > 0) { %>
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-300">
                  ● <%= book.availableCopies %> in library
                </span>
              <% } else { %>
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-rose-50 text-rose-700 border border-rose-300">
                  ● Currently all borrowed
                </span>
              <% } %>
            </div>

            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              <%= book.title %>
            </h1>
            <p class="text-sm text-slate-600 mt-1 font-semibold">
              Written by <span class="text-indigo-600"><%= book.author %></span>
            </p>

            <!-- Description -->
            <div class="mt-6">
              <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">About This Book</h3>
              <p class="text-sm text-slate-700 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-200">
                <%= book.description || 'No summary is currently available for this title.' %>
              </p>
            </div>
          </div>

          <!-- Lending & Action Section -->
          <div class="pt-6 border-t border-slate-200">
            <% if (!currentUser) { %>
              <!-- Unauthenticated -->
              <div class="p-4 rounded-xl bg-indigo-50 border border-indigo-200 flex items-center justify-between">
                <div>
                  <h4 class="text-sm font-bold text-slate-800">Interested in reading this book?</h4>
                  <p class="text-xs text-slate-600">Log in or create a free membership to request loans.</p>
                </div>
                <a href="/login" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-200 transition-all">
                  Log In to Borrow
                </a>
              </div>

            <% } else if (currentUser.role === 'member') { %>
              <!-- Member Actions -->
              <div class="space-y-3">
                
                <% if (userActiveIssue) { %>
                  <% if (userActiveIssue.status === 'requested') { %>
                    <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-xs flex items-center justify-between shadow-sm">
                      <div class="flex items-center space-x-2 font-medium">
                        <span>⏳</span>
                        <span>You have a pending issue request for this book awaiting librarian approval.</span>
                      </div>
                      <a href="/issues/my-books" class="font-bold underline text-amber-800 hover:text-amber-900">View in My Books</a>
                    </div>
                  <% } else if (userActiveIssue.status === 'issued') { %>
                    <div class="p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-950 text-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 shadow-sm">
                      <div>
                        <div class="font-bold text-sm text-indigo-900">📖 You currently have this book issued!</div>
                        <div class="text-slate-600 text-xs mt-0.5">
                          Due Date: <strong class="text-indigo-700"><%= userActiveIssue.dueDate ? new Date(userActiveIssue.dueDate).toDateString() : 'N/A' %></strong>
                        </div>
                      </div>
                      <form action="/issues/return/<%= userActiveIssue._id %>" method="POST">
                        <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md shadow-emerald-200 transition-all">
                          Return Book Now
                        </button>
                      </form>
                    </div>
                  <% } %>

                <% } else if (book.availableCopies <= 0) { %>
                  <div class="p-4 rounded-xl bg-rose-50 border border-rose-300 text-rose-800 text-xs flex items-center space-x-2 font-medium">
                    <span>🚫</span>
                    <span>Book currently unavailable. All <%= book.totalCopies %> copies are currently issued to other members.</span>
                  </div>

                <% } else if (memberBorrowedCount >= maxBorrowLimit) { %>
                  <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-amber-800 text-xs flex items-center space-x-2 font-medium">
                    <span>⚠️</span>
                    <span>You have reached your maximum borrowing limit (<%= maxBorrowLimit %> books). Please return a book before requesting another.</span>
                  </div>

                <% } else { %>
                  <form action="/issues/request/<%= book._id %>" method="POST" class="flex flex-col sm:flex-row items-center gap-3">
                    <button type="submit"
                      class="w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-lg shadow-indigo-200 transition-all">
                      Request Book Issue (7 Days)
                    </button>
                    <span class="text-xs text-slate-500 font-medium">
                      Active borrowed books: <strong class="text-slate-800"><%= memberBorrowedCount %>/<%= maxBorrowLimit %></strong>
                    </span>
                  </form>
                <% } %>

              </div>

            <% } else if (currentUser.role === 'librarian') { %>
              <!-- Librarian Controls -->
              <div class="flex flex-wrap items-center gap-3">
                <a href="/books/edit/<%= book._id %>"
                  class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold border border-slate-300 transition-all">
                  ✏️ Edit Book Details & Copies
                </a>

                <form action="/books/delete/<%= book._id %>" method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this book? This action is only allowed if no copies are issued.');">
                  <button type="submit"
                    class="px-4 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold border border-rose-300 transition-all">
                    🗑️ Delete Book
                  </button>
                </form>

                <div class="text-xs text-slate-500 ml-auto font-medium">
                  Copies Issued: <strong class="text-amber-600 font-bold"><%= book.totalCopies - book.availableCopies %></strong>
                </div>
              </div>
            <% } %>
          </div>

        </div>

      </div>
    </div>

    <!-- Librarian Recent Issues on this Book -->
    <% if (currentUser && currentUser.role === 'librarian' && recentIssues && recentIssues.length > 0) { %>
      <div class="mt-10 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">Lending History for this Title</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-700">
            <thead class="bg-slate-50 text-slate-600 uppercase tracking-wider text-[11px] border-b border-slate-200 font-bold">
              <tr>
                <th class="py-3 px-4">Member</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4">Issue Date</th>
                <th class="py-3 px-4">Due Date</th>
                <th class="py-3 px-4">Return Date</th>
                <th class="py-3 px-4">Fine</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% recentIssues.forEach(iss => { %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-3 px-4 font-bold text-slate-800">
                    <%= iss.member ? iss.member.name : 'Unknown' %>
                    <span class="block text-[10px] text-slate-500 font-normal"><%= iss.member ? iss.member.email : '' %></span>
                  </td>
                  <td class="py-3 px-4">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase <%= iss.status === 'issued' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : (iss.status === 'returned' ? 'bg-emerald-50 text-emerald-700 border border-emerald-300' : 'bg-slate-100 text-slate-600') %>">
                      <%= iss.status %>
                    </span>
                  </td>
                  <td class="py-3 px-4 font-medium"><%= iss.issueDate ? new Date(iss.issueDate).toLocaleDateString() : 'N/A' %></td>
                  <td class="py-3 px-4 font-medium"><%= iss.dueDate ? new Date(iss.dueDate).toLocaleDateString() : 'N/A' %></td>
                  <td class="py-3 px-4 font-medium"><%= iss.returnDate ? new Date(iss.returnDate).toLocaleDateString() : '—' %></td>
                  <td class="py-3 px-4 font-bold <%= iss.fine > 0 ? 'text-rose-600' : 'text-slate-500' %>">
                    <%= iss.fine > 0 ? '₹' + iss.fine : '₹0' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
