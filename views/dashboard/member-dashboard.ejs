<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Welcome Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-800">
      <div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">
          Welcome, <%= currentUser.name %>!
        </h1>
        <p class="text-xs text-slate-400 mt-1">Here is the current status of your library account and reading loans.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/books" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md transition-all">
          Explore Books & Borrow &rarr;
        </a>
      </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
      
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Active Loans</div>
        <div class="mt-2 text-2xl font-black text-white"><%= activeLoans.length %></div>
        <div class="mt-1 text-[10px] text-slate-500">Quota: <%= activeLoans.length %> / <%= maxBorrowLimit %> books</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Pending Requests</div>
        <div class="mt-2 text-2xl font-black text-amber-400"><%= pendingRequests.length %></div>
        <div class="mt-1 text-[10px] text-slate-500">Awaiting librarian approval</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Completed Loans</div>
        <div class="mt-2 text-2xl font-black text-emerald-400"><%= returnedCount %></div>
        <div class="mt-1 text-[10px] text-slate-500">Books returned safely</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Fines</div>
        <div class="mt-2 text-2xl font-black <%= totalFines > 0 ? 'text-rose-400' : 'text-slate-300' %>">
          ₹<%= totalFines %>
        </div>
        <div class="mt-1 text-[10px] text-slate-500">Based on ₹10/overdue day</div>
      </div>

    </div>

    <!-- Active Loans Section -->
    <div class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <span>📖</span> Your Active Book Loans (<%= activeLoans.length %>)
        </h2>
        <a href="/issues/my-books" class="text-xs text-indigo-400 hover:text-indigo-300">View Full Loan History &rarr;</a>
      </div>

      <% if (activeLoans.length === 0) { %>
        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center">
          <p class="text-xs text-slate-400">You currently have no books borrowed from the library.</p>
          <a href="/books" class="mt-3 inline-block px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors">
            Browse Our Collection
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% activeLoans.forEach(loan => { %>
            <div class="bg-slate-900 border <%= loan.isOverdue ? 'border-rose-800/80 bg-rose-950/10' : 'border-slate-800' %> rounded-2xl p-5 flex flex-col justify-between shadow-sm">
              <div>
                <div class="flex justify-between items-start">
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-800 text-slate-300">
                    <%= loan.book ? loan.book.category : 'General' %>
                  </span>
                  
                  <% if (loan.isOverdue) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-rose-950 text-rose-300 border border-rose-800">
                      Overdue (+<%= loan.overdueDays %>d)
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-indigo-950 text-indigo-300 border border-indigo-800">
                      Active
                    </span>
                  <% } %>
                </div>

                <h3 class="font-bold text-sm text-white mt-3">
                  <%= loan.book ? loan.book.title : 'Book Title' %>
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">by <%= loan.book ? loan.book.author : '' %></p>

                <div class="mt-4 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-1 text-xs">
                  <div class="flex justify-between text-slate-400">
                    <span>Due on:</span>
                    <span class="font-mono <%= loan.isOverdue ? 'text-rose-400 font-bold' : 'text-slate-200' %>">
                      <%= loan.dueDate ? new Date(loan.dueDate).toLocaleDateString() : '—' %>
                    </span>
                  </div>
                  <% if (loan.isOverdue) { %>
                    <div class="flex justify-between text-rose-400 font-semibold pt-1 border-t border-rose-900/30">
                      <span>Accrued Fine:</span>
                      <span class="font-mono">₹<%= loan.estimatedFine %></span>
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between">
                <a href="/books/<%= loan.book ? loan.book._id : '#' %>" class="text-xs text-indigo-400 hover:text-indigo-300">
                  Details &rarr;
                </a>
                <form action="/issues/return/<%= loan._id %>" method="POST">
                  <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition-all">
                    Return Book
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Popular Recommended Books -->
    <% if (popularBooks && popularBooks.length > 0) { %>
      <div class="mt-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>🔥</span> Popular in Library
          </h2>
          <a href="/books" class="text-xs text-indigo-400 hover:text-indigo-300">View All</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <% popularBooks.forEach(b => { %>
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition-colors">
              <div>
                <span class="text-[10px] uppercase font-bold text-indigo-400"><%= b.category %></span>
                <h4 class="font-bold text-sm text-white mt-1 line-clamp-1">
                  <a href="/books/<%= b._id %>" class="hover:text-indigo-300"><%= b.title %></a>
                </h4>
                <p class="text-xs text-slate-400 mt-0.5">by <%= b.author %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
                <span class="text-emerald-400 font-semibold"><%= b.availableCopies %> copies left</span>
                <a href="/books/<%= b._id %>" class="font-semibold text-indigo-400 hover:text-indigo-300">Borrow &rarr;</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
