<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="flex flex-col min-h-full">
  <%- include('../partials/navbar') %>
  <%- include('../partials/alerts') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-slate-800">
      <div>
        <div class="flex items-center space-x-3">
          <span class="text-3xl">📊</span>
          <div>
            <h1 class="text-2xl font-extrabold text-white tracking-tight">Library Operational Dashboard</h1>
            <p class="text-xs text-slate-400">Real-time inventory metrics, lending pipeline, and overdue monitoring.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/books/add" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md transition-all">
          + Add New Book
        </a>
        <a href="/issues/requests" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-all">
          Review Requests (<%= stats.pendingRequests %>)
        </a>
      </div>
    </div>

    <!-- 6 Primary Metric Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-6">
      
      <!-- Total Books -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Titles</div>
        <div class="mt-2 text-2xl font-black text-white"><%= stats.totalBooks %></div>
        <div class="mt-1 text-[10px] text-slate-500">Distinct catalog titles</div>
      </div>

      <!-- Total Copies -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Copies</div>
        <div class="mt-2 text-2xl font-black text-indigo-400"><%= stats.totalCopies %></div>
        <div class="mt-1 text-[10px] text-slate-500">Gross physical inventory</div>
      </div>

      <!-- Issued Books -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Issued Books</div>
        <div class="mt-2 text-2xl font-black text-cyan-400"><%= stats.issuedBooks %></div>
        <div class="mt-1 text-[10px] text-slate-500">Actively with members</div>
      </div>

      <!-- Available Copies -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Available Books</div>
        <div class="mt-2 text-2xl font-black text-emerald-400"><%= stats.availableCopies %></div>
        <div class="mt-1 text-[10px] text-slate-500">Ready to lend</div>
      </div>

      <!-- Overdue Books -->
      <div class="bg-slate-900 border <%= stats.overdueBooks > 0 ? 'border-rose-800/80 bg-rose-950/20' : 'border-slate-800' %> rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Overdue Books</div>
        <div class="mt-2 text-2xl font-black <%= stats.overdueBooks > 0 ? 'text-rose-400' : 'text-slate-300' %>">
          <%= stats.overdueBooks %>
        </div>
        <div class="mt-1 text-[10px] text-slate-500">Past scheduled due date</div>
      </div>

      <!-- Total Members -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Members</div>
        <div class="mt-2 text-2xl font-black text-amber-400"><%= stats.totalMembers %></div>
        <div class="mt-1 text-[10px] text-slate-500">Registered patrons</div>
      </div>

    </div>

    <!-- 2 Column Layout: Most Borrowed Titles + Upcoming & Overdue Returns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-10">
      
      <!-- Most Borrowed Books (Top 5) -->
      <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>🏆</span> Most-Borrowed Books (Top 5)
            </h2>
            <span class="text-xs text-slate-500">Ranked by borrowCount</span>
          </div>

          <% if (mostBorrowedBooks.length === 0) { %>
            <div class="text-center py-8 text-xs text-slate-500">
              No borrowing activity recorded yet.
            </div>
          <% } else { %>
            <div class="space-y-3">
              <% mostBorrowedBooks.forEach((book, idx) => { %>
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 hover:border-slate-700 transition-colors">
                  <div class="flex items-center space-x-3">
                    <span class="w-6 h-6 rounded-lg bg-indigo-950 text-indigo-400 border border-indigo-800/60 flex items-center justify-center font-bold text-xs">
                      <%= idx + 1 %>
                    </span>
                    <div>
                      <a href="/books/<%= book._id %>" class="text-xs font-semibold text-white hover:text-indigo-300 transition-colors line-clamp-1">
                        <%= book.title %>
                      </a>
                      <span class="text-[10px] text-slate-400">by <%= book.author %> • <%= book.category %></span>
                    </div>
                  </div>

                  <div class="text-right pl-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-indigo-900/40 text-indigo-300 border border-indigo-700/30">
                      <%= book.borrowCount %> loans
                    </span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 text-right">
          <a href="/books" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">
            View All Catalog Books &rarr;
          </a>
        </div>
      </div>

      <!-- Upcoming Returns & Overdue -->
      <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>⏰</span> Upcoming & Overdue Returns
            </h2>
            <a href="/issues/issued" class="text-xs text-indigo-400 hover:text-indigo-300">View All</a>
          </div>

          <% if (upcomingReturns.length === 0) { %>
            <div class="text-center py-8 text-xs text-slate-500">
              No active books currently out on loan.
            </div>
          <% } else { %>
            <div class="space-y-3">
              <% upcomingReturns.forEach(item => { %>
                <div class="flex items-center justify-between p-3 rounded-xl <%= item.isOverdue ? 'bg-rose-950/20 border border-rose-900/40' : 'bg-slate-950/60 border border-slate-800/80' %>">
                  <div class="min-w-0 pr-3">
                    <div class="text-xs font-semibold text-white truncate">
                      <%= item.book ? item.book.title : 'Book Title' %>
                    </div>
                    <div class="text-[10px] text-slate-400">
                      Borrowed by: <strong class="text-slate-200"><%= item.member ? item.member.name : 'Unknown' %></strong>
                    </div>
                  </div>

                  <div class="text-right flex-shrink-0 flex items-center space-x-3">
                    <div>
                      <div class="text-xs font-mono font-bold <%= item.isOverdue ? 'text-rose-400' : 'text-slate-300' %>">
                        <%= item.dueDate ? new Date(item.dueDate).toLocaleDateString() : '—' %>
                      </div>
                      <div class="text-[10px] text-slate-500">
                        <%= item.isOverdue ? `Overdue (${item.overdueDays}d)` : 'Due Date' %>
                      </div>
                    </div>

                    <form action="/issues/return/<%= item._id %>" method="POST">
                      <button type="submit" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm transition-colors">
                        Return
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 text-right">
          <a href="/issues/issued" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">
            Audit All Lending Records &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Recent Pending Requests Banner -->
    <% if (recentRequests && recentRequests.length > 0) { %>
      <div class="mt-8 bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span>📥</span> Action Required: Pending Issue Requests (<%= recentRequests.length %>)
          </h3>
          <a href="/issues/requests" class="text-xs text-indigo-400 hover:text-indigo-300">Go to Requests Center &rarr;</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <% recentRequests.forEach(req => { %>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <div>
                <div class="text-xs font-semibold text-white"><%= req.book ? req.book.title : 'Book' %></div>
                <div class="text-[10px] text-slate-400">For: <%= req.member ? req.member.name : 'Member' %></div>
              </div>
              <form action="/issues/approve/<%= req._id %>" method="POST">
                <button type="submit" class="px-3 py-1 rounded-lg text-[11px] font-semibold text-emerald-300 bg-emerald-950/60 border border-emerald-800/60 hover:bg-emerald-900/80 transition-all">
                  Approve
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
